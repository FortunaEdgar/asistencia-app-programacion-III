          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"codigoEmpleado\": \"EMP-901\",\n    \"nombreEmpleado\": \"Pedro Diaz\",\n    \"fecha\": \"2026-10-20\",\n    \"horaEntrada\": \"09:00:00\",\n    \"horaSalida\": \"08:00:00\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}",
