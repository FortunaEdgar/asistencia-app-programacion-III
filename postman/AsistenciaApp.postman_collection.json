                  "pm.test(\"Entrada 08:30 recalcula el estado a Tardanza\", () => pm.expect(a.estado).to.eql(\"Tardanza\"));",
                  "",
                  "pm.test(\"Guarda la salida y la observacion\", () => {",
                  "    pm.expect(a.horaSalida).to.eql(\"17:00:00\");",
                  "    pm.expect(a.observacion).to.eql(\"Cita medica\");",
                  "});"
