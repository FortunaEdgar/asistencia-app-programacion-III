{
  "info": {
    "_postman_id": "c20d705c-5a7a-4202-bdb0-23a6fed153ab",
    "name": "AsistenciaApp",
    "description": "Pruebas de los endpoints de AsistenciaApp con persistencia en PostgreSQL (EF Core).\n\nEjecutar en orden con el Collection Runner: cada carpeta depende de las anteriores (el POST guarda el `id` que usan PATCH y DELETE).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "58178750"
  },
  "item": [
    {
      "name": "Consultas",
      "item": [
        {
          "name": "Listar asistencias",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const asistencias = pm.response.json();",
                  "",
                  "pm.test(\"Devuelve un arreglo\", () => pm.expect(asistencias).to.be.an(\"array\"));",
                  "",
                  "pm.test(\"Incluye los datos iniciales de la migracion\", () => {",
                  "    const ids = asistencias.map(a => a.id);",
                  "    pm.expect(ids).to.include(pm.collectionVariables.get(\"seedId\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          },
          "response": []
        },
        {
          "name": "Obtener asistencia por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"Devuelve la asistencia de Ana Martinez\", () => {",
                  "    const a = pm.response.json();",
                  "    pm.expect(a.codigoEmpleado).to.eql(\"EMP-001\");",
                  "    pm.expect(a.nombreEmpleado).to.eql(\"Ana Martinez\");",
                  "    pm.expect(a.estado).to.eql(\"Presente\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{seedId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{seedId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Obtener asistencia inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
                  "",
                  "pm.test(\"Devuelve mensaje de error\", () => {",
                  "    pm.expect(pm.response.json().mensaje).to.include(\"No existe una asistencia\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
