        {
          "name": "Crear asistencia sin campos obligatorios",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "",
                  "pm.test(\"Informa los campos obligatorios\", () => {",
                  "    const errors = pm.response.json().errors;",
                  "    pm.expect(errors).to.have.property(\"CodigoEmpleado\");",
                  "    pm.expect(errors).to.have.property(\"NombreEmpleado\");",
                  "    pm.expect(errors).to.have.property(\"Fecha\");",
                  "    pm.expect(errors).to.have.property(\"HoraEntrada\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          },
          "response": []
        }
