    {
      "name": "Crear",
      "item": [
        {
          "name": "Crear asistencia puntual",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Codigo unico por ejecucion para no chocar con el indice CodigoEmpleado + Fecha",
                  "pm.collectionVariables.set(\"codigo\", \"EMP-\" + Date.now().toString().slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const a = pm.response.json();",
                  "",
                  "pm.test(\"Incluye cabecera Location\", () => pm.response.to.have.header(\"Location\"));",
                  "",
                  "pm.test(\"Entrada 08:05 se marca como Presente\", () => pm.expect(a.estado).to.eql(\"Presente\"));",
                  "",
                  "pm.test(\"Guarda los datos enviados\", () => {",
                  "    pm.expect(a.codigoEmpleado).to.eql(pm.collectionVariables.get(\"codigo\"));",
                  "    pm.expect(a.nombreEmpleado).to.eql(\"Maria Gomez\");",
                  "    pm.expect(a.fecha).to.eql(\"2026-10-27\");",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"id\", a.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"codigoEmpleado\": \"{{codigo}}\",\n    \"nombreEmpleado\": \"  Maria Gomez  \",\n    \"fecha\": \"2026-10-27\",\n    \"horaEntrada\": \"08:05:00\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          },
          "response": []
        },
        {
          "name": "Crear asistencia duplicada",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Mismo empleado en minusculas: la validacion no distingue mayusculas",
                  "pm.variables.set(\"codigoMinusculas\", pm.collectionVariables.get(\"codigo\").toLowerCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "",
                  "pm.test(\"Rechaza el registro duplicado\", () => {",
                  "    pm.expect(pm.response.json().mensaje).to.include(\"Ya existe un registro\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"codigoEmpleado\": \"{{codigoMinusculas}}\",\n    \"nombreEmpleado\": \"Maria Gomez\",\n    \"fecha\": \"2026-10-27\",\n    \"horaEntrada\": \"08:00:00\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          },
          "response": []
        },
        {
          "name": "Crear asistencia con fecha futura",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const manana = new Date();",
                  "manana.setDate(manana.getDate() + 1);",
                  "pm.variables.set(\"fechaFutura\", manana.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "",
                  "pm.test(\"Rechaza la fecha futura\", () => {",
                  "    pm.expect(pm.response.json().mensaje).to.include(\"fecha futura\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"codigoEmpleado\": \"EMP-900\",\n    \"nombreEmpleado\": \"Pedro Diaz\",\n    \"fecha\": \"{{fechaFutura}}\",\n    \"horaEntrada\": \"08:00:00\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          },
          "response": []
        },
        {
          "name": "Crear asistencia con salida antes de entrada",
